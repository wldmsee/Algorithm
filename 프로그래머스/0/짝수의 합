
// 짝수의 합
/*
    - 문제 설명
    정수 n이 주어질 때, n이하의 짝수를 모두 더한 값을 return 하도록 solution 함수를 작성해주세요.

    - 제한 사항
    0 < n ≤ 1000

    - 입출력 예
     n	result
    10	  30
     4	   6

    - 입출력 설명
    입출력 예 #1
        n이 10이므로 2 + 4 + 6 + 8 + 10 = 30을 return 합니다.
    입출력 예 #2
        n이 4이므로 2 + 4 = 6을 return 합니다.

        ex. n=7
        짝수 2 4 6 > 3개

        2 + 4 + 6 = 12


    - 접근 방법
    for문 / 짝수 / sum
    0 < n ≤ 1000
    n 이하 임의의 수 = a

    a = 1; a <= n; a++
    if ( a % 2 == 0 ) >> 짝수
    sum += a;

*/

class Solution22 {
    public int solution(int n) {
        int sum = 0;
            for (int a = 1; a <= n; a++) {
                if ( a % 2 == 0 ) {
                    sum += a;
                }
                //  for(int i=2; i<=n; i+=2){
                //            answer+=i;
                //        }
            }
        return sum;
    }
}

