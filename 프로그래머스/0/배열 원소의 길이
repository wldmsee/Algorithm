
// 배열 원소의 길이
/*
    - 문제 설명
     문자열 배열 strlist가 매개변수로 주어집니다. strlist 각 원소의 길이를 담은 배열을 return하도록 solution 함수를 완성해주세요.


    - 제한 사항
    1 ≤ strlist 원소의 길이 ≤ 100
    strlist는 알파벳 소문자, 대문자, 특수문자로 구성되어 있습니다.


    - 입출력 예
                   strlist	                result
        ["We", "are", "the", "world!"]	 [2, 3, 3, 6]
        ["I", "Love", "Programmers."]	  [1, 4, 12]


    - 입출력 예 설명
        입출력 예 #1
        ["We", "are", "the", "world!"]의 각 원소의 길이인 [2, 3, 3, 6]을 return합니다.

        입출력 예 #2
        ["I", "Love", "Programmers."]의 각 원소의 길이인 [1, 4, 12]을 return합니다.


    - 접근 방법
      answer = 문자열 배열의 각 원소의 길이
      answer 길이 : strlist.length / answer 원소 : strlist[i].length
      배열 순회 > 각 원소를 하나의 배열로 취급해서 순회
      answer[j] = strlist[i].length

      for ( int j = strlist[i].length; i < strlist.length; i++ ) {
      }

      >>
      배열 크기 정의
      int[] answer = new int[strlist.length];
      배열 순회 for문
      for (int i = 0; i < strlist.length; i++)
      배열 원소
      answer[i] = strlist[i].length();


*/

class Solution29 {
    public int[] solution(String[] strlist) {
//        int[] answer = {};
//        int i = 0;
//        for ( int j = strlist[i].length(); j < strlist.length; j++ ) {
//        }
        int[] answer = new int[strlist.length];
            for (int i = 0; i < strlist.length; i++) {
                answer[i] = strlist[i].length();
            }
        return answer;
    }
}

